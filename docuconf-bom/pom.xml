<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- No parent on purpose: importing a BOM imports its parent's dependency management too, and docuconf-parent
       pins a Spring Boot version. Keep the version equal to docuconf-parent's (the release sets both). -->
  <groupId>dev.docuconf</groupId>
  <artifactId>docuconf-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>docuconf BOM</name>
  <description>One version for every docuconf artifact: import it in dependencyManagement.</description>
  <url>https://docuconf.dev/languages/java/</url>

  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>docuconf</id>
      <name>The docuconf authors</name>
      <url>https://github.com/docuconf</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/docuconf/docuconf-java.git</connection>
    <developerConnection>scm:git:git@github.com:docuconf/docuconf-java.git</developerConnection>
    <url>https://github.com/docuconf/docuconf-java</url>
  </scm>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.docuconf</groupId>
        <artifactId>docuconf-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.docuconf</groupId>
        <artifactId>docuconf-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.docuconf</groupId>
        <artifactId>docuconf-spring</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!-- With no parent, the BOM does not inherit docuconf-parent's release profile, so it signs itself and joins the
       Central Portal deployment here. Keep the plugin versions and configuration equal to docuconf-parent's. -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- The passphrase comes from MAVEN_GPG_PASSPHRASE. -->
                  <bestPractices>true</bestPractices>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.8.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
